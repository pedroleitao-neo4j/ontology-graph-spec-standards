// The sample data

MERGE (n:IsoCountry {isoCountryCode: 'NO'}) SET n += {isoCountryName: 'Norway'};
MERGE (n:IsoCountry {isoCountryCode: 'GB'}) SET n += {isoCountryName: 'United Kingdom'};
MERGE (n:IsoCurrency {isoCurrencyCode: 'EUR'}) SET n += {isoCurrencyName: 'Euro'};
MERGE (n:IsoLanguage {isoLanguageCode: 'en'}) SET n += {isoLanguageName: 'English'};
MERGE (n:MeasurementSystem {measurementSystemCode: 'SI'}) SET n += {measurementSystemName: 'International System of Units'};
MERGE (n:UnitOfMeasureDimension {unitOfMeasureDimensionCode: 'L3T-1'}) SET n += {unitOfMeasureDimensionName: 'volume flow rate', cfihosUniqueCode: 'CFIHOS-60000021'};
MERGE (n:UnitOfMeasureDimension {unitOfMeasureDimensionCode: 'L2MT-3'}) SET n += {unitOfMeasureDimensionName: 'power', cfihosUniqueCode: 'CFIHOS-60000034'};
MERGE (n:UnitOfMeasureDimension {unitOfMeasureDimensionCode: 'T'}) SET n += {unitOfMeasureDimensionName: 'time', cfihosUniqueCode: 'CFIHOS-60000002'};
MERGE (n:UnitOfMeasureDimension {unitOfMeasureDimensionCode: '1'}) SET n += {unitOfMeasureDimensionName: 'dimensionless', cfihosUniqueCode: 'CFIHOS-60000001'};
MERGE (n:UnitOfMeasure {unitOfMeasureName: 'cubic metre per hour'}) SET n += {unitOfMeasureSymbol: 'm3/h', unitOfMeasureDimensionCode: 'L3T-1', measurementSystemCode: 'SI', cfihosUniqueCode: 'CFIHOS-70000412'};
MERGE (n:UnitOfMeasure {unitOfMeasureName: 'kilowatt'}) SET n += {unitOfMeasureSymbol: 'kW', unitOfMeasureDimensionCode: 'L2MT-3', measurementSystemCode: 'SI', cfihosUniqueCode: 'CFIHOS-70000233'};
MERGE (n:UnitOfMeasure {unitOfMeasureName: 'week'}) SET n += {unitOfMeasureSymbol: 'wk', unitOfMeasureDimensionCode: 'T', measurementSystemCode: 'SI', cfihosUniqueCode: 'CFIHOS-70000561'};
MERGE (n:UnitOfMeasure {unitOfMeasureName: 'each'}) SET n += {unitOfMeasureSymbol: 'ea', unitOfMeasureDimensionCode: '1', measurementSystemCode: 'SI', cfihosUniqueCode: 'CFIHOS-70000102'};
MERGE (n:DataType {dataTypeCode: 'NUM'}) SET n += {dataTypeName: 'numeric'};
MERGE (n:QuantitativeProperty {propertyName: 'rated volume flow rate'}) SET n:Property, n += {propertyDefinition: 'The volume flow rate at the rated operating point of the pump.', propertyDataType: 'NUM', cfihosUniqueCode: 'CFIHOS-40000512', unitOfMeasureDimensionCode: 'L3T-1'};
MERGE (n:QuantitativeProperty {propertyName: 'rated power'}) SET n:Property, n += {propertyDefinition: 'The power output a driver is designed to deliver continuously.', propertyDataType: 'NUM', cfihosUniqueCode: 'CFIHOS-40000488', unitOfMeasureDimensionCode: 'L2MT-3'};
