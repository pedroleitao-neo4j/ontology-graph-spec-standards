// The sample data

MERGE (n:Equipment {id: 'NORDCELL'}) SET n:InformationObject, n += {description: ['Nordcell, a fictional battery cell manufacturer'], equipmentLevel: 'Enterprise', publishedDate: datetime('2024-01-15T00:00:00Z')};
MERGE (n:Equipment {id: 'HALDEN'}) SET n:InformationObject, n += {description: ['The Halden cell plant'], equipmentLevel: 'Site'};
MERGE (n:Equipment {id: 'HALDEN-COAT'}) SET n:InformationObject, n += {description: ['Coating area'], equipmentLevel: 'Area'};
MERGE (n:Equipment {id: 'HALDEN-COAT-L1'}) SET n:InformationObject, n += {description: ['Coating line 1'], equipmentLevel: 'ProductionLine'};
MERGE (n:Equipment {id: 'C-101'}) SET n:InformationObject, n += {description: ['Slot die coater'], equipmentLevel: 'WorkUnit'};
MERGE (n:Equipment {id: 'D-102'}) SET n:InformationObject, n += {description: ['Conveyor dryer'], equipmentLevel: 'WorkUnit'};
MERGE (n:EquipmentClass {id: 'COATERS'}) SET n:InformationObject, n += {description: ['Slot die coaters'], equipmentLevel: 'WorkUnit'};
MERGE (n:EquipmentClassProperty {id: 'COATERS-MAX-WIDTH'}) SET n += {value: ['1600'], valueDataType: ['Numeric'], valueUnitOfMeasure: ['mm'], valueKey: ['MaxWebWidth']};
MERGE (n:EquipmentProperty {id: 'C-101-SPEED'}) SET n += {value: ['120'], valueDataType: ['Numeric'], valueUnitOfMeasure: ['m/min'], valueKey: ['MaxWebSpeed']};
MERGE (n:PersonnelClass {id: 'COATING-OPERATORS'}) SET n:InformationObject, n += {description: ['Coating line operators']};
MERGE (n:Person {id: 'P-2041'}) SET n:InformationObject, n += {personName: 'Magnus Dahl'};
MERGE (n:MaterialClass {id: 'SLURRY'}) SET n:InformationObject, n += {description: ['Electrode slurries'], assemblyType: 'Physical', assemblyRelationship: 'Transient'};
MERGE (n:MaterialDefinition {id: 'SLR-A12'}) SET n:InformationObject, n += {description: ['Anode slurry, grade A12']};
MERGE (n:MaterialDefinitionProperty {id: 'SLR-A12-VISC'}) SET n += {value: ['4200'], valueDataType: ['Numeric'], valueUnitOfMeasure: ['mPa.s'], valueKey: ['Viscosity']};
MERGE (n:MaterialLot {id: 'LOT-2026-11-07A'}) SET n:InformationObject, n += {description: ['Anode slurry, grade A12'], status: 'Available', disposition: 'UnRestricted', quantity: ['500'], quantityDataType: ['Quantity'], quantityUnitOfMeasure: ['kg']};
MERGE (n:ProcessSegment {id: 'PS-COAT-CAL'}) SET n:InformationObject, n += {description: ['Coat the current collector foil and calender it'], operationsType: 'Production'};
MERGE (n:ProcessSegment {id: 'PS-DRY'}) SET n:InformationObject, n += {description: ['Dry the coated electrode'], operationsType: 'Production'};
MERGE (n:MaterialSegmentSpecification {id: 'MSS-COAT'}) SET n += {description: ['Anode slurry consumed per batch'], materialUse: 'Consumed', quantity: ['300'], quantityDataType: ['Quantity'], quantityUnitOfMeasure: ['kg']};
MERGE (n:EquipmentSegmentSpecification {id: 'ESS-COAT'}) SET n += {description: ['The coater the segment runs on'], equipmentUse: 'Primary', quantity: ['1'], quantityDataType: ['Quantity'], quantityUnitOfMeasure: ['EA']};
MERGE (n:SegmentDependency {id: 'SD-DRY'}) SET n += {description: ['Drying follows coating'], dependency: 'AfterEnd'};
MERGE (n:OperationsDefinition {id: 'OPD-COAT-001'}) SET n:InformationObject, n += {description: ['Coating operations, standard run'], operationsType: 'Production'};
MERGE (n:OperationsSegment {id: 'OPS-COAT'}) SET n:InformationObject, n += {description: ['Coating operations, standard run'], operationsType: 'Production', duration: duration('PT4H0M0S')};
MERGE (n:OperationsSchedule {id: 'SCH-2026-11-10'}) SET n:InformationObject, n += {description: ['Coating line 1, 10 November 2026'], operationsType: 'Production', scheduleState: 'Released', publishedDate: datetime('2026-11-09T16:20:00Z'), startTime: datetime('2026-11-10T06:00:00Z'), endTime: datetime('2026-11-10T14:00:00Z')};
MERGE (n:OperationsRequest {id: 'REQ-2026-11-10-A'}) SET n:InformationObject, n += {description: ['One batch of A12 electrode'], operationsType: 'Production', requestState: 'Released', priority: 1.0, startTime: datetime('2026-11-10T06:00:00Z'), endTime: datetime('2026-11-10T14:00:00Z')};
MERGE (n:OpSegmentRequirement {id: 'SR-2026-11-10-1'}) SET n += {operationsType: 'Production', segmentState: 'Completed', earliestStartTime: datetime('2026-11-10T06:00:00Z'), latestEndTime: datetime('2026-11-10T09:00:00Z'), duration: duration('PT2H15M0S')};
MERGE (n:OpSegmentRequirement {id: 'SR-2026-11-10-2'}) SET n += {operationsType: 'Production', segmentState: 'Completed', earliestStartTime: datetime('2026-11-10T08:30:00Z'), latestEndTime: datetime('2026-11-10T12:00:00Z'), duration: duration('PT2H10M0S')};
