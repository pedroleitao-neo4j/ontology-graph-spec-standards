// MITRE D3FEND 1.6.0: the graph model and sample data
//
// Generated by ../../cypher.py from model.json and sample.json. Edit those and regenerate, rather than this file.
//
// Phishing seen through D3FEND 1.6.0: the ATT&CK techniques Spearphishing Attachment and Link and the User Execution
// that follows, the email, URL, mail traffic and executable file artifacts they produce, access or execute, and the
// D3FEND defensive techniques that analyse, filter or block those artifacts, such as Sender Reputation Analysis,
// Homoglyph Detection, URL Analysis, Email Filtering, Dynamic Analysis and Executable Allowlisting. Each defensive
// technique has a reference from its knowledge base article, the ATT&CK mitigations D3FEND relates them to are
// included, as are the NIST SP 800-53 controls mapped to Dynamic Analysis. Every class, individual and link is taken
// from the D3FEND 1.6.0 knowledge graph.
//
// Run it against an empty database of Neo4j 5 or later, Enterprise Edition, for its node key and property existence
// constraints, e.g. with cypher-shell -f model.cypher. It merges every node and relationship, so it can be run again.

// The model: its constraints

CREATE CONSTRAINT uri_D3FENDClass_key IF NOT EXISTS FOR (n:D3FENDClass) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_DefensiveTactic_key IF NOT EXISTS FOR (n:DefensiveTactic) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_DefensiveTechnique_key IF NOT EXISTS FOR (n:DefensiveTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_AnalyticTechnique_key IF NOT EXISTS FOR (n:AnalyticTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_AnalyticalPurpose_key IF NOT EXISTS FOR (n:AnalyticalPurpose) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_OffensiveTactic_key IF NOT EXISTS FOR (n:OffensiveTactic) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_OffensiveTechnique_key IF NOT EXISTS FOR (n:OffensiveTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ATTACKICSTechnique_key IF NOT EXISTS FOR (n:ATTACKICSTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ATTACKMobileTechnique_key IF NOT EXISTS FOR (n:ATTACKMobileTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ATLASTechnique_key IF NOT EXISTS FOR (n:ATLASTechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_SPARTATechnique_key IF NOT EXISTS FOR (n:SPARTATechnique) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Weakness_key IF NOT EXISTS FOR (n:Weakness) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_DigitalArtifact_key IF NOT EXISTS FOR (n:DigitalArtifact) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_PhysicalArtifact_key IF NOT EXISTS FOR (n:PhysicalArtifact) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Artifact_key IF NOT EXISTS FOR (n:Artifact) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_File_key IF NOT EXISTS FOR (n:File) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Software_key IF NOT EXISTS FOR (n:Software) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Process_key IF NOT EXISTS FOR (n:Process) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_NetworkTraffic_key IF NOT EXISTS FOR (n:NetworkTraffic) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_NetworkNode_key IF NOT EXISTS FOR (n:NetworkNode) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Event_key IF NOT EXISTS FOR (n:Event) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Agent_key IF NOT EXISTS FOR (n:Agent) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Sensor_key IF NOT EXISTS FOR (n:Sensor) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_TechniqueReference_key IF NOT EXISTS FOR (n:TechniqueReference) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ExternalControl_key IF NOT EXISTS FOR (n:ExternalControl) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ControlCatalog_key IF NOT EXISTS FOR (n:ControlCatalog) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ATTACKEnterpriseMitigation_key IF NOT EXISTS FOR (n:ATTACKEnterpriseMitigation) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ATTACKEnterpriseDataSource_key IF NOT EXISTS FOR (n:ATTACKEnterpriseDataSource) REQUIRE n.uri IS NODE KEY;

// The sample data

MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1566'}) SET n:D3FENDClass, n += {name: 'Phishing', definition: 'Adversaries may send phishing messages to gain access to victim systems.', attackId: 'T1566', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1566.001'}) SET n:D3FENDClass, n += {name: 'Spearphishing Attachment', definition: 'Adversaries may send spearphishing emails with a malicious attachment in an attempt to gain access to victim systems.', attackId: 'T1566.001', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1566.002'}) SET n:D3FENDClass, n += {name: 'Spearphishing Link', definition: 'Adversaries may send spearphishing emails with a malicious link in an attempt to gain access to victim systems.', attackId: 'T1566.002', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204'}) SET n:D3FENDClass, n += {name: 'User Execution', definition: 'An adversary may rely upon specific actions by a user in order to gain execution.', attackId: 'T1204', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204.001'}) SET n:D3FENDClass, n += {name: 'Malicious Link', definition: 'An adversary may rely upon a user clicking a malicious link in order to gain execution.', attackId: 'T1204.001', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204.002'}) SET n:D3FENDClass, n += {name: 'Malicious File', definition: 'An adversary may rely upon a user opening a malicious file in order to gain execution.', attackId: 'T1204.002', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InitialAccessTechnique'}) SET n:D3FENDClass, n += {name: 'Initial Access Technique', definition: 'The adversary is trying to get into your network.', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionTechnique'}) SET n:D3FENDClass, n += {name: 'Execution Technique', definition: 'The adversary is trying to run malicious code.', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0001'}) SET n:D3FENDClass, n += {name: 'Initial Access', definition: 'The adversary is trying to get into your network.', framework: 'ATT&CK Enterprise'};
MERGE (n:OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0002'}) SET n:D3FENDClass, n += {name: 'Execution', definition: 'The adversary is trying to run malicious code.', framework: 'ATT&CK Enterprise'};
MERGE (n:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Detect'}) SET n:D3FENDClass, n += {name: 'Detect', definition: 'The detect tactic is used to identify adversary access to or unauthorized activity on computer networks.'};
MERGE (n:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Isolate'}) SET n:D3FENDClass, n += {name: 'Isolate', definition: 'The isolate tactic creates logical or physical barriers in a system which reduces opportunities for adversaries to create further accesses.'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAnalysis'}) SET n:D3FENDClass, n += {name: 'Message Analysis', definition: 'Analyzing email or instant message content to detect unauthorized activity.', d3fendId: 'D3-MA'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierAnalysis'}) SET n:D3FENDClass, n += {name: 'Identifier Analysis', definition: 'Analyzing identifier artifacts such as IP address, domain names, or URL(I)s.', d3fendId: 'D3-ID'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#FileAnalysis'}) SET n:D3FENDClass, n += {name: 'File Analysis', definition: 'File Analysis is an analytic process to determine a file\'s status.', d3fendId: 'D3-FA'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionIsolation'}) SET n:D3FENDClass, n += {name: 'Execution Isolation', definition: 'Execution Isolation techniques prevent application processes from accessing non-essential system resources, such as memory, devices, or files.', d3fendId: 'D3-EI'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering'}) SET n:D3FENDClass, n += {name: 'Inbound Traffic Filtering', definition: 'Restricting network traffic originating from untrusted networks destined towards a private host or enclave.', d3fendId: 'D3-ITF'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#SenderReputationAnalysis'}) SET n:D3FENDClass, n += {name: 'Sender Reputation Analysis', definition: 'Ascertaining sender reputation based on information associated with a message (e.g.', d3fendId: 'D3-SRA'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#HomoglyphDetection'}) SET n:D3FENDClass, n += {name: 'Homoglyph Detection', definition: 'Comparing strings using a variety of techniques to determine if a deceptive or malicious string is being presented to a user.', d3fendId: 'D3-HD'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis'}) SET n:D3FENDClass, n += {name: 'URL Analysis', definition: 'Determining if a URL is benign or malicious by analyzing the URL or its components.', d3fendId: 'D3-UA'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#EmailFiltering'}) SET n:D3FENDClass, n += {name: 'Email Filtering', definition: 'Filtering incoming email traffic based on specific criteria.', d3fendId: 'D3-EF'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis'}) SET n:D3FENDClass, n += {name: 'Dynamic Analysis', definition: 'Executing or opening a file in a synthetic "sandbox" environment to determine if the file is a malicious program or if the file exploits another program such as a document reader.', d3fendId: 'D3-DA'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableAllowlisting'}) SET n:D3FENDClass, n += {name: 'Executable Allowlisting', definition: 'Using a digital signature to authenticate a file before opening.', d3fendId: 'D3-EAL'};
MERGE (n:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting'}) SET n:D3FENDClass, n += {name: 'Executable Denylisting', definition: 'Blocking the execution of files on a host in accordance with defined application policy rules.', d3fendId: 'D3-EDL'};
MERGE (n:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Email'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Email', definition: 'An email, or email message, is a document that is sent between computer users across computer networks.'};
MERGE (n:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#EmailAttachment'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Email Attachment', definition: 'An email attachment is a computer file sent along with an email message.'};
MERGE (n:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URL'}) SET n:Artifact:D3FENDClass, n += {name: 'URL', definition: 'A Uniform Resource Locator (URL), commonly informally termed a web address (a term which is not defined identically) is a reference to a web resource that specifies its location on a computer network and a mechanism for retrieving it.A URL is a specific type of Uniform Resource Identifier (URI), although many people use the two terms interchangeably.'};
MERGE (n:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Executable File', definition: 'In computing, executable code or an executable file or executable program, sometimes simply an executable, causes a computer "to perform indicated tasks according to encoded instructions," as opposed to a data file that must be parsed by a program to be meaningful.'};
MERGE (n:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DocumentFile'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Document File', definition: 'A document is a written, drawn, presented or recorded representation of thoughts.'};
MERGE (n:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#File'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'File', definition: 'A file maintained in computer-readable form.'};
MERGE (n:NetworkTraffic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetMailTraffic'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Inbound Internet Mail Traffic', definition: 'Inbound internet mail traffic is network traffic that is: (a) coming from a host outside a given network via an incoming connection to a host inside that same network, and (b) using a standard protocol for email.'};
MERGE (n:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#CreateProcess'}) SET n:Artifact:D3FENDClass, n += {name: 'Create Process', definition: 'A process spawn refers to a function that loads and executes a new child process.The current process may wait for the child to terminate or may continue to execute asynchronously.'};
MERGE (n:Process {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Process'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Process', definition: 'A process is an instance of a computer program that is being executed.'};
MERGE (n:NetworkTraffic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetWebTraffic'}) SET n:DigitalArtifact:Artifact:D3FENDClass, n += {name: 'Outbound Internet Web Traffic', definition: 'Outbound internet web traffic is network traffic that is: (a) on an outgoing connection initiated from a host within a network to a host outside the network, and (b) using a standard web protocol.'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-SystemsAndMethodsForDetectingAnd_orHandlingTargetedAttacksInTheEmailChannel_GraphusInc'}) SET n += {name: 'Reference - Systems and methods for detecting and/or handling targeted attacks in the email channel - Graphus Inc', title: 'Systems and methods for detecting and/or handling targeted attacks in the email channel', organization: 'Graphus Inc', link: 'https://patents.google.com/patent/US20170324767A1', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-Computer-implementedMethodsAndSystemsForIdentifyingVisuallySimilarTextCharacterStrings_GreathornInc'}) SET n += {name: 'Reference - Computer-implemented methods and systems for identifying visually similar text character strings - Greathorn Inc', title: 'Computer-implemented methods and systems for identifying visually similar text character strings', organization: 'Greathorn Inc', link: 'https://patents.google.com/patent/US10320815B2/en?oq=US-10320815-B2', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-MethodAndApparatusForDetectingMaliciousWebsites_EndgameInc'}) SET n += {name: 'Reference - Method and Apparatus for Detecting Malicious Websites - Endgame Inc', title: 'Method and Apparatus for Detecting Malicious Websites', organization: 'Endgame Inc', link: 'https://patents.google.com/patent/US20140331319A1', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-SystemAndMethodForProvidingAnonymousRemailingAndFilteringOfElectronicMail_Nokia'}) SET n += {name: 'Reference - System and method for providing anonymous remailing and filtering of electronic mail - Nokia', title: 'System and method for providing anonymous remailing and filtering of electronic mail', organization: 'Nokia of America Corp', link: 'https://patents.google.com/patent/JPH11161574A', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-MalwareAnalysisSystem_PaloAltoNetworksInc'}) SET n += {name: 'Reference - Malware analysis system - Palo Alto Networks Inc', title: 'Malware analysis system', organization: 'Palo Alto Networks Inc', link: 'https://patents.google.com/patent/US20150319136A1', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-ComputingApparatusWithAutomaticIntegrityReferenceGenerationAndMaintenance_Tripwire,Inc.'}) SET n += {name: 'Reference - Computing apparatus with automatic integrity reference generation and maintenance - Tripwire, Inc.', title: 'Computing apparatus with automatic integrity reference generation and maintenance', organization: 'Tripwire, Inc.', link: 'https://patents.google.com/patent/US20040060046A1', kind: 'PatentReference'};
MERGE (n:TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-ContentExtractorAndAnalysisSystem_Bit9Inc,CarbonBlackInc'}) SET n += {name: 'Reference - Content extractor and analysis system - Bit 9 Inc, Carbon Black Inc', title: 'Content extractor and analysis system', organization: 'Bit 9 Inc, Carbon Black Inc', link: 'https://patents.google.com/patent/US20070028110A1', kind: 'PatentReference'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1021'}) SET n += {name: 'Restrict Web-Based Content', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1033'}) SET n += {name: 'Limit Software Installation', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1038'}) SET n += {name: 'Execution Prevention', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1042'}) SET n += {name: 'Disable or Remove Feature or Program', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1045'}) SET n += {name: 'Code Signing', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ATTACKEnterpriseMitigation {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#M1048'}) SET n += {name: 'Application Isolation and Sandboxing', kind: 'ATTACKEnterpriseMitigation', framework: 'ATT&CK Enterprise'};
MERGE (n:ExternalControl {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#NIST_SP_800-53_R5_IR-4_12'}) SET n += {name: 'IR-4(12)', controlName: 'Incident Handling | Malicious Code and Forensic Analysis', kind: 'NISTControl'};
MERGE (n:ExternalControl {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#NIST_SP_800-53_R5_SI-3_10'}) SET n += {name: 'SI-3(10)', controlName: 'Malicious Code Protection | Malicious Code Analysis', kind: 'NISTControl'};
MERGE (n:ControlCatalog {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#NIST_SP_800-53_R5'}) SET n += {name: 'NIST SP 800-53 R5', version: '5', kind: 'NISTSP800-53ControlCatalog'};

MATCH (a:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204.001'}), (b:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URL'}) MERGE (a)-[:ACCESSES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DocumentFile'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#FileAnalysis'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#File'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#HomoglyphDetection'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Email'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#HomoglyphDetection'}), (b:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URL'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#SenderReputationAnalysis'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Email'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis'}), (b:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URL'}) MERGE (a)-[:ANALYZES]->(b);
MATCH (a:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#EmailAttachment'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Email'}) MERGE (a)-[:ATTACHED_TO]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableAllowlisting'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile'}) MERGE (a)-[:BLOCKS]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting'}), (b:File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile'}) MERGE (a)-[:BLOCKS]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionIsolation'}), (b:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Isolate'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionTechnique'}), (b:OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0002'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#FileAnalysis'}), (b:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Detect'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierAnalysis'}), (b:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Detect'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InitialAccessTechnique'}), (b:OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0001'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAnalysis'}), (b:DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Detect'}) MERGE (a)-[:ENABLES]->(b);
MATCH (a:ExternalControl {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#NIST_SP_800-53_R5_SI-3_10'}), (b:DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis'}) MERGE (a)-[:EXACTLY]->(b);
MATCH (a:DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#CreateProcess'}), (b:Process {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Process'}) MERGE (a)-[:EXECUTES]->(b);
