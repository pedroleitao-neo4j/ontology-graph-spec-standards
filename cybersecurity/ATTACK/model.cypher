CREATE CONSTRAINT stixId_Group_key IF NOT EXISTS FOR (n:Group) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_Malware_key IF NOT EXISTS FOR (n:Malware) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_Tool_key IF NOT EXISTS FOR (n:Tool) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_Analytic_key IF NOT EXISTS FOR (n:Analytic) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_DataComponent_key IF NOT EXISTS FOR (n:DataComponent) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_DetectionStrategy_key IF NOT EXISTS FOR (n:DetectionStrategy) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_Mitigation_key IF NOT EXISTS FOR (n:Mitigation) REQUIRE n.stixId IS NODE KEY;
CREATE CONSTRAINT stixId_Asset_key IF NOT EXISTS FOR (n:Asset) REQUIRE n.stixId IS NODE KEY;

