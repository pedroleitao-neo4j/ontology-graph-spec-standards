MERGE (n:TLCOrganization {uri: 'https://example.org/akn/zz/act/2024/7/eng@#TLC1'}) SET n:Agent:TLC:RefItem, n += {eId: 'TLC1', href: 'https://example.org/ontology/agent/ZZ_NationalCouncilForLawReporting', showAs: 'National Council for Law Reporting'};
