MERGE (n:TLCEvent {uri: 'https://example.org/akn/zz/act/2024/7/eng@#TLC6'}) SET n:TLC:RefItem, n += {eId: 'TLC6', href: 'https://example.org/ontology/event/e_2589', showAs: 'Assent of the President, 12 March 2024'};
