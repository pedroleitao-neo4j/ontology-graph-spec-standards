// The sample data

MERGE (n:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}) SET n:PublicBody:LegalPerson:Organisation:Agent:Thing;
MERGE (n:NaturalPerson {uri: 'https://example.org/tenancy/member'}) SET n:Person:Agent:Thing:NaturalObject:PhysicalObject:PhysicalEntity;
MERGE (n:NaturalPerson {uri: 'https://example.org/tenancy/landlord'}) SET n:Person:Agent:Thing:NaturalObject:PhysicalObject:PhysicalEntity;
MERGE (n:NaturalPerson {uri: 'https://example.org/tenancy/tenant'}) SET n:Person:Agent:Thing:NaturalObject:PhysicalObject:PhysicalEntity;
MERGE (n:Statute {uri: 'https://example.org/tenancy/act'}) SET n:LegalDocument:Document:Medium:Thing:LegalSource;
MERGE (n:LegalExpression {uri: 'https://example.org/tenancy/actText'}) SET n:Expression:Proposition:MentalObject:MentalEntity:Thing;
MERGE (n:Obligation {uri: 'https://example.org/tenancy/repairDuty'}) SET n:Permission:Norm:Qualification:MentalObject:MentalEntity:Thing;
MERGE (n:Permission {uri: 'https://example.org/tenancy/withholdPermission'}) SET n:Norm:Qualification:MentalObject:MentalEntity:Thing;
MERGE (n:Prohibition {uri: 'https://example.org/tenancy/evictionProhibition'}) SET n:Permission:Norm:Qualification:MentalObject:MentalEntity:Thing;
MERGE (n:Obliged {uri: 'https://example.org/tenancy/repairing'}) SET n:Allowed:NormativelyQualified:Qualified:Thing;
MERGE (n:StrictlyAllowed {uri: 'https://example.org/tenancy/withholding'}) SET n:Allowed:NormativelyQualified:Qualified:Thing;
MERGE (n:Disallowed {uri: 'https://example.org/tenancy/evictingWithoutOrder'}) SET n:NormativelyQualified:Qualified:Thing;
MERGE (n:Contract {uri: 'https://example.org/tenancy/lease'}) SET n:LegalDocument:Document:Medium:Thing:LegalSource;
MERGE (n:Expression {uri: 'https://example.org/tenancy/leaseTerms'}) SET n:Proposition:MentalObject:MentalEntity:Thing;
MERGE (n:Obligation {uri: 'https://example.org/tenancy/rentDuty'}) SET n:Permission:Norm:Qualification:MentalObject:MentalEntity:Thing;
MERGE (n:Obliged {uri: 'https://example.org/tenancy/payingRent'}) SET n:Allowed:NormativelyQualified:Qualified:Thing;
MERGE (n:SocialLegalRole {uri: 'https://example.org/tenancy/landlordRole'}) SET n:LegalRole:Role:SubjectiveEntity:MentalEntity:Thing:SocialRole;
MERGE (n:SocialLegalRole {uri: 'https://example.org/tenancy/tenantRole'}) SET n:LegalRole:Role:SubjectiveEntity:MentalEntity:Thing:SocialRole;
MERGE (n:StatementInWriting {uri: 'https://example.org/tenancy/bill'}) SET n:CommunicatedAttitude:PropositionalAttitude:MentalObject:MentalEntity:Thing;
MERGE (n:SpeechAct {uri: 'https://example.org/tenancy/billIntroduction'}) SET n:Creation:Action:Process:Change:Thing;
MERGE (n:Moment {uri: 'https://example.org/tenancy/introductionDay'}) SET n:Atom:AbstractEntity:Thing:TemporalOccurrence:SpatioTemporalOccurrence:Occurrence;
MERGE (n:Declaration {uri: 'https://example.org/tenancy/promulgation'}) SET n:CommunicatedAttitude:PropositionalAttitude:MentalObject:MentalEntity:Thing;
MERGE (n:ActOfLaw {uri: 'https://example.org/tenancy/enactment'}) SET n:LegalSpeechAct:SpeechAct:Creation:Action:Process:Change:Thing:PublicAct;
MERGE (n:Moment {uri: 'https://example.org/tenancy/enactmentDay'}) SET n:Atom:AbstractEntity:Thing:TemporalOccurrence:SpatioTemporalOccurrence:Occurrence;
MERGE (n:Document {uri: 'https://example.org/tenancy/noticeLetter'}) SET n:Medium:Thing;
MERGE (n:Expression {uri: 'https://example.org/tenancy/noticeText'}) SET n:Proposition:MentalObject:MentalEntity:Thing;
MERGE (n:StatementInWriting {uri: 'https://example.org/tenancy/notice'}) SET n:CommunicatedAttitude:PropositionalAttitude:MentalObject:MentalEntity:Thing;
MERGE (n:SpeechAct {uri: 'https://example.org/tenancy/noticeGiving'}) SET n:Creation:Action:Process:Change:Thing;
MERGE (n:Moment {uri: 'https://example.org/tenancy/noticeDay'}) SET n:Atom:AbstractEntity:Thing:TemporalOccurrence:SpatioTemporalOccurrence:Occurrence;
MERGE (n:Promise {uri: 'https://example.org/tenancy/rentPromise'}) SET n:CommunicatedAttitude:PropositionalAttitude:MentalObject:MentalEntity:Thing;
MERGE (n:PhysicalObject {uri: 'https://example.org/tenancy/dwelling'}) SET n:PhysicalEntity:Thing;
MERGE (n:Action {uri: 'https://example.org/tenancy/repairs'}) SET n:Process:Change:Thing;
MERGE (n:Moment {uri: 'https://example.org/tenancy/repairDay'}) SET n:Atom:AbstractEntity:Thing:TemporalOccurrence:SpatioTemporalOccurrence:Occurrence;

MATCH (a:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}), (b:NaturalPerson {uri: 'https://example.org/tenancy/member'}) MERGE (a)-[:MEMBER]->(b);
MATCH (a:Statute {uri: 'https://example.org/tenancy/act'}), (b:Obligation {uri: 'https://example.org/tenancy/repairDuty'}) MERGE (a)-[:BEARS]->(b);
MATCH (a:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}), (b:Obligation {uri: 'https://example.org/tenancy/repairDuty'}) MERGE (a)-[:HOLDS]->(b);
MATCH (a:Statute {uri: 'https://example.org/tenancy/act'}), (b:Permission {uri: 'https://example.org/tenancy/withholdPermission'}) MERGE (a)-[:BEARS]->(b);
MATCH (a:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}), (b:Permission {uri: 'https://example.org/tenancy/withholdPermission'}) MERGE (a)-[:HOLDS]->(b);
MATCH (a:Statute {uri: 'https://example.org/tenancy/act'}), (b:Prohibition {uri: 'https://example.org/tenancy/evictionProhibition'}) MERGE (a)-[:BEARS]->(b);
MATCH (a:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}), (b:Prohibition {uri: 'https://example.org/tenancy/evictionProhibition'}) MERGE (a)-[:HOLDS]->(b);
MATCH (a:Statute {uri: 'https://example.org/tenancy/act'}), (b:LegalExpression {uri: 'https://example.org/tenancy/actText'}) MERGE (a)-[:BEARS]->(b);
MATCH (a:LegislativeBody {uri: 'https://example.org/tenancy/parliament'}), (b:LegalExpression {uri: 'https://example.org/tenancy/actText'}) MERGE (a)-[:HOLDS]->(b);
