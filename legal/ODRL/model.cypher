MATCH (a:Duty {uri: 'http://example.com/rule/monthly-usage-report'}), (b:Party {uri: 'http://example.com/party/northwind-records'}) MERGE (a)-[:INFORMED_PARTY]->(b);
MATCH (a:Duty {uri: 'http://example.com/rule/monthly-usage-report'}), (b:AssetCollection {uri: 'http://example.com/asset/album/harbour-lights'}) MERGE (a)-[:TARGET]->(b);
MATCH (a:Agreement {uri: 'http://example.com/policy/harbour-lights-tunely-2025'}), (b:Prohibition {uri: 'http://example.com/rule/no-commercial-sync'}) MERGE (a)-[:PROHIBITION]->(b);
MATCH (a:Prohibition {uri: 'http://example.com/rule/no-commercial-sync'}), (b:Action {uri: 'http://www.w3.org/ns/odrl/2/commercialize'}) MERGE (a)-[:ACTION]->(b);
MATCH (a:Prohibition {uri: 'http://example.com/rule/no-commercial-sync'}), (b:AssetCollection {uri: 'http://example.com/asset/album/harbour-lights'}) MERGE (a)-[:TARGET]->(b);
MATCH (a:Prohibition {uri: 'http://example.com/rule/no-commercial-sync'}), (b:Party {uri: 'http://example.com/party/tunely'}) MERGE (a)-[:ASSIGNEE]->(b);
