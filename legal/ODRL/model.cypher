MERGE (n:ConflictTerm {uri: 'http://www.w3.org/ns/odrl/2/perm'}) SET n:Thing;
MERGE (n:Party {uri: 'http://example.com/party/northwind-records'}) SET n:Thing, n += {uid: ['urn:lei:5299000EXAMPLE0000001']};
MERGE (n:Party {uri: 'http://example.com/party/tunely'}) SET n:Thing;
MERGE (n:Party {uri: 'http://example.com/party/the-lantern-years'}) SET n:Thing;
MERGE (n:PartyCollection {uri: 'http://example.com/party/northwind-music-group'}) SET n:Party:Thing, n += {source: ['http://example.com/party/northwind-music-group/members']};
MERGE (n:AssetCollection {uri: 'http://example.com/asset/album/harbour-lights'}) SET n:Asset:Thing, n += {uid: ['urn:upc:0123456789012'], source: ['http://example.com/catalogue/albums']};
MERGE (n:Asset {uri: 'http://example.com/asset/track/harbour-lights/01'}) SET n:Thing, n += {uid: ['urn:isrc:GBXXX2400001']};
MERGE (n:Asset {uri: 'http://example.com/asset/track/harbour-lights/02'}) SET n:Thing, n += {uid: ['urn:isrc:GBXXX2400002']};
MERGE (n:Asset {uri: 'http://example.com/asset/track/harbour-lights/03'}) SET n:Thing, n += {uid: ['urn:isrc:GBXXX2400003']};
