MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/modify'}) SET n:Thing;
MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/delete'}) SET n:Thing;
MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/commercialize'}) SET n:Thing;
MERGE (n:LeftOperand {uri: 'http://www.w3.org/ns/odrl/2/spatial'}) SET n:Thing;
