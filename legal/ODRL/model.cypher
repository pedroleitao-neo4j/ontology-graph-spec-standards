// ODRL 2.2: the graph model and sample data
//
// Generated by ../../cypher.py from model.json and sample.json. Edit those and regenerate, rather than this file.
//
// A record label, Northwind Records, licenses an album and its four tracks. Its catalogue-wide Set policy prohibits
// modifying the recordings, with deleting modified copies as the remedy; an Offer inherits from it and lets anyone
// stream the album for a per-stream fee; and an Agreement with the streaming service Tunely inherits from the offer,
// permitting it to stream and play the album in the EU or the UK until the end of 2027, with duties to pay, to
// attribute the artist and to report usage monthly, and a prohibition on commercialising it. ODRL's actions, left
// operands and operators are nodes keyed by their ODRL IRIs; the companies and their IRIs are fictional.
//
// Run it against an empty database of Neo4j 5 or later, Enterprise Edition, for its node key and property existence
// constraints, e.g. with cypher-shell -f model.cypher. It merges every node and relationship, so it can be run again.

// The model: its constraints

CREATE CONSTRAINT uri_Thing_key IF NOT EXISTS FOR (n:Thing) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Action_key IF NOT EXISTS FOR (n:Action) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Agreement_key IF NOT EXISTS FOR (n:Agreement) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Assertion_key IF NOT EXISTS FOR (n:Assertion) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Asset_key IF NOT EXISTS FOR (n:Asset) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_AssetCollection_key IF NOT EXISTS FOR (n:AssetCollection) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_AssetScope_key IF NOT EXISTS FOR (n:AssetScope) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ConflictTerm_key IF NOT EXISTS FOR (n:ConflictTerm) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Constraint_key IF NOT EXISTS FOR (n:Constraint) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Duty_key IF NOT EXISTS FOR (n:Duty) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LeftOperand_key IF NOT EXISTS FOR (n:LeftOperand) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LogicalConstraint_key IF NOT EXISTS FOR (n:LogicalConstraint) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Offer_key IF NOT EXISTS FOR (n:Offer) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Operator_key IF NOT EXISTS FOR (n:Operator) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Party_key IF NOT EXISTS FOR (n:Party) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_PartyCollection_key IF NOT EXISTS FOR (n:PartyCollection) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_PartyScope_key IF NOT EXISTS FOR (n:PartyScope) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Permission_key IF NOT EXISTS FOR (n:Permission) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Policy_key IF NOT EXISTS FOR (n:Policy) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Privacy_key IF NOT EXISTS FOR (n:Privacy) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Prohibition_key IF NOT EXISTS FOR (n:Prohibition) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Request_key IF NOT EXISTS FOR (n:Request) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_RightOperand_key IF NOT EXISTS FOR (n:RightOperand) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Rule_key IF NOT EXISTS FOR (n:Rule) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Set_key IF NOT EXISTS FOR (n:Set) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Ticket_key IF NOT EXISTS FOR (n:Ticket) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_UndefinedTerm_key IF NOT EXISTS FOR (n:UndefinedTerm) REQUIRE n.uri IS NODE KEY;

// The sample data

MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/use'}) SET n:Thing;
MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/play'}) SET n:Thing;
MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/stream'}) SET n:Thing;
MERGE (n:Action {uri: 'http://www.w3.org/ns/odrl/2/compensate'}) SET n:Thing;
