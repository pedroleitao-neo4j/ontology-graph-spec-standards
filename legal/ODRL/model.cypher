MERGE (n:Constraint {uri: 'http://example.com/constraint/inEU'}) SET n:Thing, n += {rightOperand: ['https://www.wikidata.org/wiki/Q458']};
MERGE (n:Constraint {uri: 'http://example.com/constraint/inUK'}) SET n:Thing, n += {rightOperand: ['https://www.wikidata.org/wiki/Q145']};
MERGE (n:Constraint {uri: 'http://example.com/constraint/until2027'}) SET n:Thing, n += {rightOperand: ['2027-12-31'], dataType: ['http://www.w3.org/2001/XMLSchema#date']};
MERGE (n:Constraint {uri: 'http://example.com/constraint/perStream'}) SET n:Thing, n += {rightOperand: ['0.004'], dataType: ['http://www.w3.org/2001/XMLSchema#decimal'], unit: ['http://dbpedia.org/resource/Euro']};
MERGE (n:Constraint {uri: 'http://example.com/constraint/flac'}) SET n:Thing, n += {rightOperand: ['audio/flac']};
MERGE (n:LogicalConstraint {uri: 'http://example.com/constraint/territory'}) SET n:Thing, n += {or: ['http://example.com/constraint/inEU', 'http://example.com/constraint/inUK']};
MERGE (n:Set {uri: 'http://example.com/policy/northwind-catalogue'}) SET n:Policy:Thing, n += {uid: ['http://example.com/policy/northwind-catalogue'], profile: ['http://example.com/profile/music-licensing']};
MERGE (n:Offer {uri: 'http://example.com/policy/harbour-lights-offer'}) SET n:Policy:Thing, n += {uid: ['http://example.com/policy/harbour-lights-offer'], profile: ['http://example.com/profile/music-licensing']};
MERGE (n:Agreement {uri: 'http://example.com/policy/harbour-lights-tunely-2025'}) SET n:Policy:Thing, n += {uid: ['http://example.com/policy/harbour-lights-tunely-2025'], profile: ['http://example.com/profile/music-licensing']};
MERGE (n:Prohibition {uri: 'http://example.com/rule/no-modify'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/delete-modified-copies'}) SET n:Rule:Thing;
MERGE (n:Permission {uri: 'http://example.com/rule/offer-stream'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/offer-pay'}) SET n:Rule:Thing;
MERGE (n:Permission {uri: 'http://example.com/rule/agrStream'}) SET n:Rule:Thing;
MERGE (n:Permission {uri: 'http://example.com/rule/agrPlay'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/agreement-pay'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/agreement-attribute'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/late-payment-notice'}) SET n:Rule:Thing;
MERGE (n:Duty {uri: 'http://example.com/rule/monthly-usage-report'}) SET n:Rule:Thing;
MERGE (n:Prohibition {uri: 'http://example.com/rule/no-commercial-sync'}) SET n:Rule:Thing;

MATCH (a:Action {uri: 'http://www.w3.org/ns/odrl/2/play'}), (b:Action {uri: 'http://www.w3.org/ns/odrl/2/use'}) MERGE (a)-[:INCLUDED_IN]->(b);
