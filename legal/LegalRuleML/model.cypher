// The sample data

MERGE (n:LegalStatus {uri: 'http://docs.oasis-open.org/legalruleml/ns/v1.0/vocab#InForce'});
MERGE (n:StatusDevelopment {uri: 'http://docs.oasis-open.org/legalruleml/ns/v1.0/vocab#Starts'});
MERGE (n:StrictStrength {uri: 'http://example.com/rta2024#strict'}) SET n:Strength:Associable:Commentable;
MERGE (n:DefeasibleStrength {uri: 'http://example.com/rta2024#defeasible'}) SET n:Strength:Associable:Commentable;
MERGE (n:Agent {uri: 'http://example.com/rta2024#parliament'}) SET n:Actor;
MERGE (n:Agent {uri: 'http://example.com/rta2024#draftingOffice'}) SET n:Actor;
MERGE (n:Agent {uri: 'http://example.com/rta2024#janeDoe'}) SET n:Actor;
MERGE (n:Agent {uri: 'http://example.com/rta2024#acmeLettings'}) SET n:Actor;
MERGE (n:Agents {uri: 'http://example.com/rta2024#agents'}) SET n:Collection:Commentable;
MERGE (n:Function {uri: 'http://example.com/rta2024#tenantFn'});
MERGE (n:Function {uri: 'http://example.com/rta2024#landlordFn'});
MERGE (n:Figure {uri: 'http://example.com/rta2024#tenantFigure'}) SET n:Actor;
MERGE (n:Figure {uri: 'http://example.com/rta2024#landlordFigure'}) SET n:Actor;
MERGE (n:Figures {uri: 'http://example.com/rta2024#figures'}) SET n:Collection:Commentable;
MERGE (n:Author {uri: 'http://example.com/rta2024#author'}) SET n:Role;
MERGE (n:Editor {uri: 'http://example.com/rta2024#editor'}) SET n:Role;
MERGE (n:Roles {uri: 'http://example.com/rta2024#roles'}) SET n:Collection:Commentable;
MERGE (n:Authority {uri: 'http://example.com/rta2024#parliamentAuthority'}) SET n:Associable:Commentable;
MERGE (n:Authorities {uri: 'http://example.com/rta2024#authorities'}) SET n:Collection:Commentable;
MERGE (n:Jurisdiction {uri: 'http://example.com/rta2024#victoria'}) SET n:Associable:Commentable;
MERGE (n:Jurisdictions {uri: 'http://example.com/rta2024#jurisdictions'}) SET n:Collection:Commentable;
MERGE (n:LegalSource {uri: 'http://example.com/rta2024#source-s30'}) SET n:Source:Associable:Commentable:Collectable;
MERGE (n:LegalSource {uri: 'http://example.com/rta2024#source-s91'}) SET n:Source:Associable:Commentable:Collectable;
MERGE (n:LegalSource {uri: 'http://example.com/rta2024#source-s92'}) SET n:Source:Associable:Commentable:Collectable;
MERGE (n:LegalSource {uri: 'http://example.com/rta2024#source-s95'}) SET n:Source:Associable:Commentable:Collectable;
MERGE (n:LegalSources {uri: 'http://example.com/rta2024#sources'}) SET n:Sources:Collection:Commentable:Collector;
MERGE (n:Source {uri: 'http://example.com/rta2024#source-act'}) SET n:Associable:Commentable:Collectable;
MERGE (n:LegalReference {uri: 'http://example.com/rta2024#refs30'}) SET n:Reference:Collectable, n += {refID: ['Residential Tenancies (Example) Act 2024, s 30'], refIDSystemName: ['Example Statute Book']};
MERGE (n:LegalReference {uri: 'http://example.com/rta2024#refs91'}) SET n:Reference:Collectable, n += {refID: ['Residential Tenancies (Example) Act 2024, s 91'], refIDSystemName: ['Example Statute Book']};
MERGE (n:LegalReference {uri: 'http://example.com/rta2024#refs92'}) SET n:Reference:Collectable, n += {refID: ['Residential Tenancies (Example) Act 2024, s 92'], refIDSystemName: ['Example Statute Book']};
MERGE (n:LegalReference {uri: 'http://example.com/rta2024#refs95'}) SET n:Reference:Collectable, n += {refID: ['Residential Tenancies (Example) Act 2024, s 95'], refIDSystemName: ['Example Statute Book']};
MERGE (n:LegalReferences {uri: 'http://example.com/rta2024#references'}) SET n:References:Collection:Commentable;
MERGE (n:Times {uri: 'http://example.com/rta2024#times'}) SET n:Collection:Commentable;
MERGE (n:TemporalCharacteristic {uri: 'http://example.com/rta2024#inForceFromCommencement'}) SET n:Associable:Commentable;
MERGE (n:TemporalCharacteristics {uri: 'http://example.com/rta2024#temporal'}) SET n:Collection:Commentable:Associable;
MERGE (n:Data {uri: 'http://example.com/rta2024#tenant'}) SET n:Term:WellFormedExpression, n += {symbolForData: ['tenant']};
MERGE (n:Data {uri: 'http://example.com/rta2024#landlord'}) SET n:Term:WellFormedExpression, n += {symbolForData: ['landlord']};
MERGE (n:Data {uri: 'http://example.com/rta2024#rent'}) SET n:Term:WellFormedExpression, n += {symbolForData: ['rent']};
MERGE (n:Data {uri: 'http://example.com/rta2024#dueDate'}) SET n:Term:WellFormedExpression, n += {symbolForData: ['dueDate']};
MERGE (n:Data {uri: 'http://example.com/rta2024#noticePeriod'}) SET n:Term:WellFormedExpression, n += {symbolForData: ['noticePeriod']};
MERGE (n:PrescriptiveStatement {uri: 'http://example.com/rta2024#payRent'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:PrescriptiveStatement {uri: 'http://example.com/rta2024#notice28'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:PrescriptiveStatement {uri: 'http://example.com/rta2024#notice14'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:PrescriptiveStatement {uri: 'http://example.com/rta2024#noEntry'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:PenaltyStatement {uri: 'http://example.com/rta2024#lateFee'}) SET n:LogicalFormulaStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:ConstitutiveStatement {uri: 'http://example.com/rta2024#definesRent'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:FactualStatement {uri: 'http://example.com/rta2024#rentLate'}) SET n:LogicalFormulaStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:OverrideStatement {uri: 'http://example.com/rta2024#notice14Prevails'}) SET n:LogicalFormulaStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:ReparationStatement {uri: 'http://example.com/rta2024#lateFeeRepairs'}) SET n:LogicalFormulaStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:Statements {uri: 'http://example.com/rta2024#statements'}) SET n:Alternative:Expression:Commentable:Collection:Collector:Scope;
MERGE (n:Obligation {uri: 'http://example.com/rta2024#rentObligation'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Obligation {uri: 'http://example.com/rta2024#noticeObligation'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Permission {uri: 'http://example.com/rta2024#shortNotice'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Prohibition {uri: 'http://example.com/rta2024#entryProhibition'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Right {uri: 'http://example.com/rta2024#quietEnjoyment'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Violation {uri: 'http://example.com/rta2024#rentViolation'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Compliance {uri: 'http://example.com/rta2024#feeCompliance'}) SET n:DeonticSpecification:LogicalFormula:Formula:WellFormedExpression;
MERGE (n:Override {uri: 'http://example.com/rta2024#override'}) SET n:Atom:Formula:WellFormedExpression;
MERGE (n:Reparation {uri: 'http://example.com/rta2024#reparation'}) SET n:Atom:Formula:WellFormedExpression;
MERGE (n:Alternatives {uri: 'http://example.com/rta2024#noticeInterpretations'}) SET n:Collection:Commentable;
MERGE (n:PrescriptiveStatement {uri: 'http://example.com/rta2024#notice28Business'}) SET n:RuleStatement:Statement:Alternative:Expression:Commentable:Scope;
MERGE (n:Association {uri: 'http://example.com/rta2024#assocRent'}) SET n:Associator:Commentable:Associable;
MERGE (n:Association {uri: 'http://example.com/rta2024#assocNotice'}) SET n:Associator:Commentable:Associable;
MERGE (n:Association {uri: 'http://example.com/rta2024#assocShortNotice'}) SET n:Associator:Commentable:Associable;
MERGE (n:Association {uri: 'http://example.com/rta2024#assocEntry'}) SET n:Associator:Commentable:Associable;
MERGE (n:Associations {uri: 'http://example.com/rta2024#associations'}) SET n:Collection:Commentable:Associable;
MERGE (n:Context {uri: 'http://example.com/rta2024#context'}) SET n:Associator:Commentable;
MERGE (n:Paraphrase {uri: 'http://example.com/rta2024#rentParaphrase'}) SET n:XMLLiteralWrapper:Wrapper, n += {symbol: ['The tenant must pay the rent to the landlord on or before the day it falls due.']};
MERGE (n:Comment {uri: 'http://example.com/rta2024#noticeComment'}) SET n:XMLLiteralWrapper:Wrapper, n += {symbol: ['Section 92 shortens the notice period where the premises are unfit for habitation.']};
MERGE (n:Template {uri: 'http://example.com/rta2024#noticeTemplate'}) SET n:XMLLiteralWrapper:Wrapper, n += {symbol: ['The landlord must give the tenant at least {noticePeriod} days\' notice to vacate.']};
MERGE (n:LegalRuleMLDocument {uri: 'http://example.com/rta2024#document'}) SET n:Collector:Commentable:Creatable;

MATCH (a:Agents {uri: 'http://example.com/rta2024#agents'}), (b:Agent {uri: 'http://example.com/rta2024#parliament'}) MERGE (a)-[:HAS_AGENT]->(b);
MATCH (a:Agents {uri: 'http://example.com/rta2024#agents'}), (b:Agent {uri: 'http://example.com/rta2024#draftingOffice'}) MERGE (a)-[:HAS_AGENT]->(b);
MATCH (a:Agents {uri: 'http://example.com/rta2024#agents'}), (b:Agent {uri: 'http://example.com/rta2024#janeDoe'}) MERGE (a)-[:HAS_AGENT]->(b);
MATCH (a:Agents {uri: 'http://example.com/rta2024#agents'}), (b:Agent {uri: 'http://example.com/rta2024#acmeLettings'}) MERGE (a)-[:HAS_AGENT]->(b);
MATCH (a:Figure {uri: 'http://example.com/rta2024#tenantFigure'}), (b:Agent {uri: 'http://example.com/rta2024#janeDoe'}) MERGE (a)-[:HAS_ACTOR]->(b);
MATCH (a:Figure {uri: 'http://example.com/rta2024#tenantFigure'}), (b:Function {uri: 'http://example.com/rta2024#tenantFn'}) MERGE (a)-[:HAS_FUNCTION]->(b);
MATCH (a:Figure {uri: 'http://example.com/rta2024#landlordFigure'}), (b:Agent {uri: 'http://example.com/rta2024#acmeLettings'}) MERGE (a)-[:HAS_ACTOR]->(b);
