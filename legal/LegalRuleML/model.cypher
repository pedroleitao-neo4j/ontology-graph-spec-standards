MATCH (a:Roles {uri: 'http://example.com/rta2024#roles'}), (b:Editor {uri: 'http://example.com/rta2024#editor'}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Authorities {uri: 'http://example.com/rta2024#authorities'}), (b:Authority {uri: 'http://example.com/rta2024#parliamentAuthority'}) MERGE (a)-[:HAS_AUTHORITY]->(b);
MATCH (a:Jurisdictions {uri: 'http://example.com/rta2024#jurisdictions'}), (b:Jurisdiction {uri: 'http://example.com/rta2024#victoria'}) MERGE (a)-[:HAS_JURISDICTION]->(b);
MATCH (a:LegalSources {uri: 'http://example.com/rta2024#sources'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s30'}) MERGE (a)-[:HAS_LEGAL_SOURCE]->(b);
MATCH (a:LegalSources {uri: 'http://example.com/rta2024#sources'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s91'}) MERGE (a)-[:HAS_LEGAL_SOURCE]->(b);
MATCH (a:LegalSources {uri: 'http://example.com/rta2024#sources'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s92'}) MERGE (a)-[:HAS_LEGAL_SOURCE]->(b);
MATCH (a:LegalSources {uri: 'http://example.com/rta2024#sources'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s95'}) MERGE (a)-[:HAS_LEGAL_SOURCE]->(b);
MATCH (a:LegalReference {uri: 'http://example.com/rta2024#refs30'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s30'}) MERGE (a)-[:REFERS_TO]->(b);
MATCH (a:LegalReference {uri: 'http://example.com/rta2024#refs30'}), (b:Source {uri: 'http://example.com/rta2024#source-act'}) MERGE (a)-[:REF_ID_SYSTEM_SOURCE]->(b);
MATCH (a:LegalReference {uri: 'http://example.com/rta2024#refs91'}), (b:LegalSource {uri: 'http://example.com/rta2024#source-s91'}) MERGE (a)-[:REFERS_TO]->(b);
