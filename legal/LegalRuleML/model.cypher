MATCH (a:Figures {uri: 'http://example.com/rta2024#figures'}), (b:Figure {uri: 'http://example.com/rta2024#tenantFigure'}) MERGE (a)-[:HAS_FIGURE]->(b);
MATCH (a:Figures {uri: 'http://example.com/rta2024#figures'}), (b:Figure {uri: 'http://example.com/rta2024#landlordFigure'}) MERGE (a)-[:HAS_FIGURE]->(b);
MATCH (a:Author {uri: 'http://example.com/rta2024#author'}), (b:Agent {uri: 'http://example.com/rta2024#draftingOffice'}) MERGE (a)-[:FILLED_BY]->(b);
MATCH (a:Editor {uri: 'http://example.com/rta2024#editor'}), (b:Agent {uri: 'http://example.com/rta2024#draftingOffice'}) MERGE (a)-[:FILLED_BY]->(b);
