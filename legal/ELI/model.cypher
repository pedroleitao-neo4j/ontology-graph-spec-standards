// ELI 1.4: the graph model and sample data
//
// Generated by ../../cypher.py from model.json and sample.json. Edit those and regenerate, rather than this file.
//
// The General Data Protection Regulation, Regulation (EU) 2016/679, as published in the Official Journal: its English
// and French expressions and their PDF and XHTML formats, three of its articles, the 2018 corrigendum and the
// consolidated version that includes it, and the Data Protection Directive 95/46/EC it repealed. Beside it are the
// Law Enforcement Directive (EU) 2016/680, adopted the same day, and Ireland's Data Protection Act 2018, which
// transposes the directive and ensures the implementation of the regulation. Subdivision types and versions come from
// an example table, as ELI leaves them to each publisher; the other concepts come from the EU authority tables and
// ELI's own.
//
// Run it against an empty database of Neo4j 5 or later, Enterprise Edition, for its node key and property existence
// constraints, e.g. with cypher-shell -f model.cypher. It merges every node and relationship, so it can be run again.

// The model: its constraints

CREATE CONSTRAINT uri_Expression_key IF NOT EXISTS FOR (n:Expression) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Work_key IF NOT EXISTS FOR (n:Work) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LegalExpression_key IF NOT EXISTS FOR (n:LegalExpression) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LegalResource_key IF NOT EXISTS FOR (n:LegalResource) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Manifestation_key IF NOT EXISTS FOR (n:Manifestation) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Format_key IF NOT EXISTS FOR (n:Format) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_AdministrativeArea_key IF NOT EXISTS FOR (n:AdministrativeArea) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Agent_key IF NOT EXISTS FOR (n:Agent) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ComplexWork_key IF NOT EXISTS FOR (n:ComplexWork) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_FormatType_key IF NOT EXISTS FOR (n:FormatType) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_InForce_key IF NOT EXISTS FOR (n:InForce) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Language_key IF NOT EXISTS FOR (n:Language) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LegalResourceSubdivision_key IF NOT EXISTS FOR (n:LegalResourceSubdivision) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_LegalValue_key IF NOT EXISTS FOR (n:LegalValue) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Organization_key IF NOT EXISTS FOR (n:Organization) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Person_key IF NOT EXISTS FOR (n:Person) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_ResourceType_key IF NOT EXISTS FOR (n:ResourceType) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_SubdivisionType_key IF NOT EXISTS FOR (n:SubdivisionType) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Version_key IF NOT EXISTS FOR (n:Version) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_WorkSubdivision_key IF NOT EXISTS FOR (n:WorkSubdivision) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_WorkType_key IF NOT EXISTS FOR (n:WorkType) REQUIRE n.uri IS NODE KEY;
CREATE CONSTRAINT uri_Concept_key IF NOT EXISTS FOR (n:Concept) REQUIRE n.uri IS NODE KEY;

// The sample data

MERGE (n:ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/REG'}) SET n:Concept, n += {prefLabel: ['Regulation']};
MERGE (n:ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/DIR'}) SET n:Concept, n += {prefLabel: ['Directive']};
MERGE (n:ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/CORRIGENDUM'}) SET n:Concept, n += {prefLabel: ['Corrigendum']};
MERGE (n:ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/DEC_FRAMW'}) SET n:Concept, n += {prefLabel: ['Framework decision']};
MERGE (n:Language {uri: 'http://publications.europa.eu/resource/authority/language/ENG'}) SET n:Concept, n += {prefLabel: ['English']};
MERGE (n:Language {uri: 'http://publications.europa.eu/resource/authority/language/FRA'}) SET n:Concept, n += {prefLabel: ['French']};
MERGE (n:AdministrativeArea {uri: 'http://publications.europa.eu/resource/authority/country/IRL'}) SET n:Concept, n += {prefLabel: ['Ireland']};
MERGE (n:InForce {uri: 'http://data.europa.eu/eli/ontology#InForce-inForce'}) SET n:Concept, n += {prefLabel: ['in force']};
MERGE (n:InForce {uri: 'http://data.europa.eu/eli/ontology#InForce-notInForce'}) SET n:Concept, n += {prefLabel: ['not in force']};
MERGE (n:LegalValue {uri: 'http://data.europa.eu/eli/ontology#LegalValue-official'}) SET n:Concept, n += {prefLabel: ['official']};
MERGE (n:LegalValue {uri: 'http://data.europa.eu/eli/ontology#LegalValue-unofficial'}) SET n:Concept, n += {prefLabel: ['unofficial']};
MERGE (n:FormatType {uri: 'https://www.iana.org/assignments/media-types/application/pdf'}) SET n:Concept, n += {prefLabel: ['PDF']};
MERGE (n:FormatType {uri: 'https://www.iana.org/assignments/media-types/application/xhtml+xml'}) SET n:Concept, n += {prefLabel: ['XHTML']};
MERGE (n:FormatType {uri: 'https://www.iana.org/assignments/media-types/text/html'}) SET n:Concept, n += {prefLabel: ['HTML']};
MERGE (n:SubdivisionType {uri: 'https://example.org/eli/subdivision-type/article'}) SET n:Concept, n += {prefLabel: ['Article']};
MERGE (n:Version {uri: 'https://example.org/eli/version/oj'}) SET n:Concept, n += {prefLabel: ['Official Journal']};
MERGE (n:Version {uri: 'https://example.org/eli/version/consolidated'}) SET n:Concept, n += {prefLabel: ['consolidated']};
MERGE (n:Version {uri: 'https://example.org/eli/version/enacted'}) SET n:Concept, n += {prefLabel: ['enacted']};
MERGE (n:Organization {uri: 'http://publications.europa.eu/resource/authority/corporate-body/EP'}) SET n:Agent;
MERGE (n:Organization {uri: 'http://publications.europa.eu/resource/authority/corporate-body/CONSIL'}) SET n:Agent;
MERGE (n:Organization {uri: 'http://publications.europa.eu/resource/authority/corporate-body/PUBL'}) SET n:Agent;
MERGE (n:Organization {uri: 'https://www.oireachtas.ie/'}) SET n:Agent;
MERGE (n:ComplexWork {uri: 'http://data.europa.eu/eli/reg/2016/679'}) SET n:Work;
MERGE (n:LegalResource {uri: 'http://data.europa.eu/eli/reg/2016/679/oj'}) SET n:Work, n += {date_document: date('2016-04-27'), date_publication: date('2016-05-04'), first_date_entry_in_force: date('2016-05-24'), date_applicability: [date('2018-05-25')], number: ['2016/679'], id_local: ['32016R0679']};
MERGE (n:LegalExpression {uri: 'http://data.europa.eu/eli/reg/2016/679/oj/eng'}) SET n:Expression, n += {title: ['Regulation (EU) 2016/679 of the European Parliament and of the Council of 27 April 2016 on the protection of natural persons with regard to the processing of personal data and on the free movement of such data, and repealing Directive 95/46/EC (General Data Protection Regulation)'], title_short: ['General Data Protection Regulation'], title_alternative: ['GDPR'], date_publication: date('2016-05-04')};
