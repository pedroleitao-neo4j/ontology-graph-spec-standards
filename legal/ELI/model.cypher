MERGE (n:LegalResourceSubdivision {uri: 'http://data.europa.eu/eli/reg/2016/679/art_17/oj'}) SET n:LegalResource:Work:WorkSubdivision, n += {number: ['17'], description: ['Right to erasure (\'right to be forgotten\')']};
MERGE (n:LegalResourceSubdivision {uri: 'http://data.europa.eu/eli/reg/2016/679/art_99/oj'}) SET n:LegalResource:Work:WorkSubdivision, n += {number: ['99'], description: ['Entry into force and application']};
