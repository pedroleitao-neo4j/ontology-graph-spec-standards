// The sample data

MERGE (n:Country {uri: 'https://example.com/msa-2024/usa'}) SET n:GeopoliticalEntity:GeographicRegion:Region:Thing, n += {isIndependent: true, hasTextualName: ['United States of America']};
MERGE (n:FederalState {uri: 'https://example.com/msa-2024/delaware'}) SET n:CountrySubdivision:GeopoliticalEntity:GeographicRegion:Region:Thing, n += {hasTextualName: ['Delaware']};
MERGE (n:Municipality {uri: 'https://example.com/msa-2024/wilmington'}) SET n:CountrySubdivision:GeopoliticalEntity:GeographicRegion:Region:Thing, n += {hasTextualName: ['Wilmington']};
MERGE (n:GeographicRegionKind {uri: 'https://example.com/msa-2024/kindState'}) SET n:Classifier:Aspect:Thing;
MERGE (n:GeographicRegionKind {uri: 'https://example.com/msa-2024/kindMunicipality'}) SET n:Classifier:Aspect:Thing;
MERGE (n:Jurisdiction {uri: 'https://example.com/msa-2024/jurDelaware'}) SET n:Context:Thing;
MERGE (n:StatuteLaw {uri: 'https://example.com/msa-2024/dgcl'}) SET n:Law:Thing;
MERGE (n:LegalRight {uri: 'https://example.com/msa-2024/inspectionRight'}) SET n:Right:LegalConstruct:Thing;
MERGE (n:LegalObligation {uri: 'https://example.com/msa-2024/inspectionObligation'}) SET n:Duty:LegalConstruct:Thing;
MERGE (n:LiabilityCapacity {uri: 'https://example.com/msa-2024/liabilityNorthwind'}) SET n:LegalCapacity:LegalConstruct:Thing;
MERGE (n:LiabilityCapacity {uri: 'https://example.com/msa-2024/liabilityContoso'}) SET n:LegalCapacity:LegalConstruct:Thing;
MERGE (n:LegalEntity {uri: 'https://example.com/msa-2024/northwind'}) SET n:FormalOrganization:Organization:Party:Agent:Thing:LegalPerson;
MERGE (n:OrganizationName {uri: 'https://example.com/msa-2024/northwindName'}) SET n:ContextualName:Name:Designation:Thing:ContextualDesignation, n += {hasTextValue: ['Northwind Analytics, Inc.']};
MERGE (n:OrganizationIdentifier {uri: 'https://example.com/msa-2024/northwindFileNumber'}) SET n:Identifier:Designation:Thing, n += {hasTextValue: ['7300001']};
MERGE (n:ConventionalStreetAddress {uri: 'https://example.com/msa-2024/northwindAddress'}) SET n:PhysicalAddress:Address:Index:Reference:Thing, n += {hasAddressLine1: '1000 N. King Street', hasCityName: 'Wilmington', hasPostalCode: '19801'};
MERGE (n:PhysicalLocation {uri: 'https://example.com/msa-2024/northwindPremises'}) SET n:Location:Thing;
MERGE (n:LegalEntity {uri: 'https://example.com/msa-2024/contoso'}) SET n:FormalOrganization:Organization:Party:Agent:Thing:LegalPerson;
MERGE (n:OrganizationName {uri: 'https://example.com/msa-2024/contosoName'}) SET n:ContextualName:Name:Designation:Thing:ContextualDesignation, n += {hasTextValue: ['Contoso Freight Corporation']};
MERGE (n:OrganizationIdentifier {uri: 'https://example.com/msa-2024/contosoFileNumber'}) SET n:Identifier:Designation:Thing, n += {hasTextValue: ['7300002']};
