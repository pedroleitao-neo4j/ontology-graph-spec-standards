MATCH (a:OccupationRole {uri: 'https://example.com/saltmarsh-trader/maraOccupation'}), (b:ActOfReporting {uri: 'https://example.com/saltmarsh-trader/reporting'}) MERGE (a)-[:HAS_REALIZATION]->(b);
MATCH (a:ActOfArrival {uri: 'https://example.com/saltmarsh-trader/arrival'}), (b:ActOfReporting {uri: 'https://example.com/saltmarsh-trader/reporting'}) MERGE (a)-[:PRECEDES]->(b);
