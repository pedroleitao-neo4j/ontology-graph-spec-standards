// The sample data of every standard, then the crosswalk's own and its links

MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/use'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/play'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/stream'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/compensate'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/attribute'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/inform'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/modify'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/delete'}) SET n:odrl__Thing;
MERGE (n:odrl__Action {uri: 'http://www.w3.org/ns/odrl/2/commercialize'}) SET n:odrl__Thing;
MERGE (n:odrl__LeftOperand {uri: 'http://www.w3.org/ns/odrl/2/spatial'}) SET n:odrl__Thing;
MERGE (n:odrl__LeftOperand {uri: 'http://www.w3.org/ns/odrl/2/dateTime'}) SET n:odrl__Thing;
MERGE (n:odrl__LeftOperand {uri: 'http://www.w3.org/ns/odrl/2/payAmount'}) SET n:odrl__Thing;
MERGE (n:odrl__LeftOperand {uri: 'http://www.w3.org/ns/odrl/2/fileFormat'}) SET n:odrl__Thing;
MERGE (n:odrl__Operator {uri: 'http://www.w3.org/ns/odrl/2/eq'}) SET n:odrl__Thing;
MERGE (n:odrl__Operator {uri: 'http://www.w3.org/ns/odrl/2/lteq'}) SET n:odrl__Thing;
MERGE (n:odrl__ConflictTerm {uri: 'http://www.w3.org/ns/odrl/2/perm'}) SET n:odrl__Thing;
MERGE (n:odrl__Party {uri: 'http://example.com/party/northwind-records'}) SET n:odrl__Thing, n += {uid: ['urn:lei:5299000EXAMPLE0000001']};
MERGE (n:odrl__Party {uri: 'http://example.com/party/tunely'}) SET n:odrl__Thing;
MERGE (n:odrl__Party {uri: 'http://example.com/party/the-lantern-years'}) SET n:odrl__Thing;
MERGE (n:odrl__PartyCollection {uri: 'http://example.com/party/northwind-music-group'}) SET n:odrl__Party:odrl__Thing, n += {source: ['http://example.com/party/northwind-music-group/members']};
MERGE (n:odrl__AssetCollection {uri: 'http://example.com/asset/album/harbour-lights'}) SET n:odrl__Asset:odrl__Thing, n += {uid: ['urn:upc:0123456789012'], source: ['http://example.com/catalogue/albums']};
MERGE (n:odrl__Asset {uri: 'http://example.com/asset/track/harbour-lights/01'}) SET n:odrl__Thing, n += {uid: ['urn:isrc:GBXXX2400001']};
MERGE (n:odrl__Asset {uri: 'http://example.com/asset/track/harbour-lights/02'}) SET n:odrl__Thing, n += {uid: ['urn:isrc:GBXXX2400002']};
MERGE (n:odrl__Asset {uri: 'http://example.com/asset/track/harbour-lights/03'}) SET n:odrl__Thing, n += {uid: ['urn:isrc:GBXXX2400003']};
MERGE (n:odrl__Asset {uri: 'http://example.com/asset/track/harbour-lights/04'}) SET n:odrl__Thing, n += {uid: ['urn:isrc:GBXXX2400004']};
MERGE (n:odrl__Constraint {uri: 'http://example.com/constraint/inEU'}) SET n:odrl__Thing, n += {rightOperand: ['https://www.wikidata.org/wiki/Q458']};
MERGE (n:odrl__Constraint {uri: 'http://example.com/constraint/inUK'}) SET n:odrl__Thing, n += {rightOperand: ['https://www.wikidata.org/wiki/Q145']};
MERGE (n:odrl__Constraint {uri: 'http://example.com/constraint/until2027'}) SET n:odrl__Thing, n += {rightOperand: ['2027-12-31'], dataType: ['http://www.w3.org/2001/XMLSchema#date']};
MERGE (n:odrl__Constraint {uri: 'http://example.com/constraint/perStream'}) SET n:odrl__Thing, n += {rightOperand: ['0.004'], dataType: ['http://www.w3.org/2001/XMLSchema#decimal'], unit: ['http://dbpedia.org/resource/Euro']};
MERGE (n:odrl__Constraint {uri: 'http://example.com/constraint/flac'}) SET n:odrl__Thing, n += {rightOperand: ['audio/flac']};
MERGE (n:odrl__LogicalConstraint {uri: 'http://example.com/constraint/territory'}) SET n:odrl__Thing, n += {or: ['http://example.com/constraint/inEU', 'http://example.com/constraint/inUK']};
MERGE (n:odrl__Set {uri: 'http://example.com/policy/northwind-catalogue'}) SET n:odrl__Policy:odrl__Thing, n += {uid: ['http://example.com/policy/northwind-catalogue'], profile: ['http://example.com/profile/music-licensing']};
MERGE (n:odrl__Offer {uri: 'http://example.com/policy/harbour-lights-offer'}) SET n:odrl__Policy:odrl__Thing, n += {uid: ['http://example.com/policy/harbour-lights-offer'], profile: ['http://example.com/profile/music-licensing']};
MERGE (n:odrl__Agreement {uri: 'http://example.com/policy/harbour-lights-tunely-2025'}) SET n:odrl__Policy:odrl__Thing, n += {uid: ['http://example.com/policy/harbour-lights-tunely-2025'], profile: ['http://example.com/profile/music-licensing']};
