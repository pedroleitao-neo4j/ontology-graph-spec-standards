MERGE (n:attack__Technique {stixId: 'attack-pattern--b17a1a56-e99c-403c-8948-561df0cffe81'}) SET n:attack__ATTACKObject, n += {name: 'Valid Accounts', description: 'Adversaries may obtain and abuse credentials of existing accounts as a means of gaining Initial Access, Persistence, Privilege Escalation, or Defense Evasion.', url: 'https://attack.mitre.org/techniques/T1078', created: datetime('2017-05-31T21:31:00.645Z'), modified: datetime('2026-05-12T15:12:00.707Z'), domains: ['enterprise-attack'], version: '3.0', attackId: 'T1078', platforms: ['Containers', 'ESXi', 'IaaS', 'Identity Provider', 'Linux', 'macOS', 'Network Devices', 'Office Suite', 'SaaS', 'Windows'], isSubtechnique: false};
