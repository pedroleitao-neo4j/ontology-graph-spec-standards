MERGE (n:d3fend__OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionTechnique'}) SET n:d3fend__D3FENDClass, n += {name: 'Execution Technique', definition: 'The adversary is trying to run malicious code.', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0001'}) SET n:d3fend__D3FENDClass, n += {name: 'Initial Access', definition: 'The adversary is trying to get into your network.', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__OffensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#TA0002'}) SET n:d3fend__D3FENDClass, n += {name: 'Execution', definition: 'The adversary is trying to run malicious code.', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Detect'}) SET n:d3fend__D3FENDClass, n += {name: 'Detect', definition: 'The detect tactic is used to identify adversary access to or unauthorized activity on computer networks.'};
MERGE (n:d3fend__DefensiveTactic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Isolate'}) SET n:d3fend__D3FENDClass, n += {name: 'Isolate', definition: 'The isolate tactic creates logical or physical barriers in a system which reduces opportunities for adversaries to create further accesses.'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'Message Analysis', definition: 'Analyzing email or instant message content to detect unauthorized activity.', d3fendId: 'D3-MA'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'Identifier Analysis', definition: 'Analyzing identifier artifacts such as IP address, domain names, or URL(I)s.', d3fendId: 'D3-ID'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#FileAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'File Analysis', definition: 'File Analysis is an analytic process to determine a file\'s status.', d3fendId: 'D3-FA'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutionIsolation'}) SET n:d3fend__D3FENDClass, n += {name: 'Execution Isolation', definition: 'Execution Isolation techniques prevent application processes from accessing non-essential system resources, such as memory, devices, or files.', d3fendId: 'D3-EI'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering'}) SET n:d3fend__D3FENDClass, n += {name: 'Inbound Traffic Filtering', definition: 'Restricting network traffic originating from untrusted networks destined towards a private host or enclave.', d3fendId: 'D3-ITF'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#SenderReputationAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'Sender Reputation Analysis', definition: 'Ascertaining sender reputation based on information associated with a message (e.g.', d3fendId: 'D3-SRA'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#HomoglyphDetection'}) SET n:d3fend__D3FENDClass, n += {name: 'Homoglyph Detection', definition: 'Comparing strings using a variety of techniques to determine if a deceptive or malicious string is being presented to a user.', d3fendId: 'D3-HD'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'URL Analysis', definition: 'Determining if a URL is benign or malicious by analyzing the URL or its components.', d3fendId: 'D3-UA'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#EmailFiltering'}) SET n:d3fend__D3FENDClass, n += {name: 'Email Filtering', definition: 'Filtering incoming email traffic based on specific criteria.', d3fendId: 'D3-EF'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis'}) SET n:d3fend__D3FENDClass, n += {name: 'Dynamic Analysis', definition: 'Executing or opening a file in a synthetic "sandbox" environment to determine if the file is a malicious program or if the file exploits another program such as a document reader.', d3fendId: 'D3-DA'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableAllowlisting'}) SET n:d3fend__D3FENDClass, n += {name: 'Executable Allowlisting', definition: 'Using a digital signature to authenticate a file before opening.', d3fendId: 'D3-EAL'};
MERGE (n:d3fend__DefensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting'}) SET n:d3fend__D3FENDClass, n += {name: 'Executable Denylisting', definition: 'Blocking the execution of files on a host in accordance with defined application policy rules.', d3fendId: 'D3-EDL'};
MERGE (n:d3fend__File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Email'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Email', definition: 'An email, or email message, is a document that is sent between computer users across computer networks.'};
MERGE (n:d3fend__File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#EmailAttachment'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Email Attachment', definition: 'An email attachment is a computer file sent along with an email message.'};
MERGE (n:d3fend__DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#URL'}) SET n:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'URL', definition: 'A Uniform Resource Locator (URL), commonly informally termed a web address (a term which is not defined identically) is a reference to a web resource that specifies its location on a computer network and a mechanism for retrieving it.A URL is a specific type of Uniform Resource Identifier (URI), although many people use the two terms interchangeably.'};
MERGE (n:d3fend__File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Executable File', definition: 'In computing, executable code or an executable file or executable program, sometimes simply an executable, causes a computer "to perform indicated tasks according to encoded instructions," as opposed to a data file that must be parsed by a program to be meaningful.'};
MERGE (n:d3fend__File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#DocumentFile'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Document File', definition: 'A document is a written, drawn, presented or recorded representation of thoughts.'};
MERGE (n:d3fend__File {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#File'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'File', definition: 'A file maintained in computer-readable form.'};
MERGE (n:d3fend__NetworkTraffic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetMailTraffic'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Inbound Internet Mail Traffic', definition: 'Inbound internet mail traffic is network traffic that is: (a) coming from a host outside a given network via an incoming connection to a host inside that same network, and (b) using a standard protocol for email.'};
MERGE (n:d3fend__DigitalArtifact {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#CreateProcess'}) SET n:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Create Process', definition: 'A process spawn refers to a function that loads and executes a new child process.The current process may wait for the child to terminate or may continue to execute asynchronously.'};
MERGE (n:d3fend__Process {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Process'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Process', definition: 'A process is an instance of a computer program that is being executed.'};
MERGE (n:d3fend__NetworkTraffic {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetWebTraffic'}) SET n:d3fend__DigitalArtifact:d3fend__Artifact:d3fend__D3FENDClass, n += {name: 'Outbound Internet Web Traffic', definition: 'Outbound internet web traffic is network traffic that is: (a) on an outgoing connection initiated from a host within a network to a host outside the network, and (b) using a standard web protocol.'};
MERGE (n:d3fend__TechniqueReference {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-SystemsAndMethodsForDetectingAnd_orHandlingTargetedAttacksInTheEmailChannel_GraphusInc'}) SET n += {name: 'Reference - Systems and methods for detecting and/or handling targeted attacks in the email channel - Graphus Inc', title: 'Systems and methods for detecting and/or handling targeted attacks in the email channel', organization: 'Graphus Inc', link: 'https://patents.google.com/patent/US20170324767A1', kind: 'PatentReference'};
