MERGE (n:attack__Technique {stixId: 'attack-pattern--72b74d71-8169-42aa-92e0-e7b04b9f5a08'}) SET n:attack__ATTACKObject, n += {name: 'Account Discovery', description: 'Adversaries may attempt to get a listing of valid accounts, usernames, or email addresses on a system or within a compromised environment.', url: 'https://attack.mitre.org/techniques/T1087', created: datetime('2017-05-31T21:31:06.988Z'), modified: datetime('2026-05-12T15:12:00.641Z'), domains: ['enterprise-attack'], version: '2.6', attackId: 'T1087', platforms: ['ESXi', 'IaaS', 'Identity Provider', 'Linux', 'macOS', 'Office Suite', 'SaaS', 'Windows'], isSubtechnique: false};
MERGE (n:attack__Technique {stixId: 'attack-pattern--21875073-b0ee-49e3-9077-1e2a885359af'}) SET n:attack__ATTACKObject, n += {name: 'Domain Account', description: 'Adversaries may attempt to get a listing of domain accounts.', url: 'https://attack.mitre.org/techniques/T1087/002', created: datetime('2020-02-21T21:08:26.480Z'), modified: datetime('2026-05-12T15:12:00.622Z'), domains: ['enterprise-attack'], version: '1.2', attackId: 'T1087.002', platforms: ['Linux', 'macOS', 'Windows'], isSubtechnique: true};
MERGE (n:attack__Technique {stixId: 'attack-pattern--3f18edba-28f4-4bb9-82c3-8aa60dcac5f7'}) SET n:attack__ATTACKObject, n += {name: 'Supply Chain Compromise', description: 'Adversaries may manipulate products or product delivery mechanisms prior to receipt by a final consumer for the purpose of data or system compromise.', url: 'https://attack.mitre.org/techniques/T1195', created: datetime('2018-04-18T17:59:24.739Z'), modified: datetime('2025-10-24T17:48:41.675Z'), domains: ['enterprise-attack'], version: '1.7', attackId: 'T1195', platforms: ['Linux', 'Windows', 'macOS', 'SaaS'], isSubtechnique: false};
