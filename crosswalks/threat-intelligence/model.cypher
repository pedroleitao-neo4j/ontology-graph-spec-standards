MERGE (n:attack__Technique {stixId: 'attack-pattern--b83e166d-13d7-4b52-8677-dff90c548fd7'}) SET n:attack__ATTACKObject, n += {name: 'Subvert Trust Controls', description: 'Adversaries may undermine security controls that will either warn users of untrusted activity or prevent execution of untrusted programs.', url: 'https://attack.mitre.org/techniques/T1553', created: datetime('2020-02-05T14:54:07.588Z'), modified: datetime('2026-05-12T15:12:00.709Z'), domains: ['enterprise-attack'], version: '2.0', attackId: 'T1553', platforms: ['Linux', 'macOS', 'Windows'], isSubtechnique: false};
MERGE (n:attack__Technique {stixId: 'attack-pattern--32901740-b42c-4fdd-bc02-345b5dc57082'}) SET n:attack__ATTACKObject, n += {name: 'Code Signing', description: 'Adversaries may create, acquire, or steal code signing materials to sign their malware or tools.', url: 'https://attack.mitre.org/techniques/T1553/002', created: datetime('2020-02-05T16:27:37.784Z'), modified: datetime('2026-11-04T00:55:44.584Z'), domains: ['enterprise-attack'], version: '2.0', attackId: 'T1553.002', platforms: ['macOS', 'Windows'], isSubtechnique: true};
MERGE (n:attack__Technique {stixId: 'attack-pattern--94cb00a4-b295-4d06-aa2b-5653b9c1be9c'}) SET n:attack__ATTACKObject, n += {name: 'Forge Web Credentials', description: 'Adversaries may forge credential materials that can be used to gain access to web applications or Internet services.', url: 'https://attack.mitre.org/techniques/T1606', created: datetime('2020-12-17T02:13:46.247Z'), modified: datetime('2025-10-24T17:49:07.201Z'), domains: ['enterprise-attack'], version: '1.5', attackId: 'T1606', platforms: ['SaaS', 'Windows', 'macOS', 'Linux', 'IaaS', 'Office Suite', 'Identity Provider'], isSubtechnique: false};
MERGE (n:attack__Technique {stixId: 'attack-pattern--1f9c2bae-b441-4f66-a8af-b65946ee72f2'}) SET n:attack__ATTACKObject, n += {name: 'SAML Tokens', description: 'An adversary may forge SAML tokens with any permissions claims and lifetimes if they possess a valid SAML token-signing certificate.', url: 'https://attack.mitre.org/techniques/T1606/002', created: datetime('2020-12-17T15:24:12.240Z'), modified: datetime('2025-10-24T17:48:30.302Z'), domains: ['enterprise-attack'], version: '1.4', attackId: 'T1606.002', platforms: ['SaaS', 'Windows', 'IaaS', 'Office Suite', 'Identity Provider'], isSubtechnique: true};
MERGE (n:attack__Mitigation {stixId: 'course-of-action--e3388c78-2a8d-47c2-8422-c1398b324462'}) SET n:attack__ATTACKObject, n += {name: 'Active Directory Configuration', description: 'Implement robust Active Directory (AD) configurations using group policies to secure user accounts, control access, and minimize the attack surface.', url: 'https://attack.mitre.org/mitigations/M1015', created: datetime('2019-06-06T16:39:58.291Z'), modified: datetime('2024-12-10T15:57:59.336Z'), domains: ['enterprise-attack'], version: '1.2', attackId: 'M1015'};
MERGE (n:attack__Mitigation {stixId: 'course-of-action--93e7968a-9074-4eac-8ae9-9f5200ec3317'}) SET n:attack__ATTACKObject, n += {name: 'User Account Management', description: 'User Account Management involves implementing and enforcing policies for the lifecycle of user accounts, including creation, modification, and deactivation.', url: 'https://attack.mitre.org/mitigations/M1018', created: datetime('2019-06-06T16:50:58.767Z'), modified: datetime('2026-05-12T15:12:00.731Z'), domains: ['enterprise-attack'], version: '1.2', attackId: 'M1018'};
MERGE (n:attack__Mitigation {stixId: 'course-of-action--9bb9e696-bff8-4ae1-9454-961fc7d91d5f'}) SET n:attack__ATTACKObject, n += {name: 'Privileged Account Management', description: 'Privileged Account Management focuses on implementing policies, controls, and tools to securely manage privileged accounts (e.g., SYSTEM, root, or administrative accounts).', url: 'https://attack.mitre.org/mitigations/M1026', created: datetime('2019-06-06T21:09:47.115Z'), modified: datetime('2024-12-18T18:44:23.306Z'), domains: ['enterprise-attack'], version: '1.2', attackId: 'M1026'};
