MERGE (n:attack__Technique {stixId: 'attack-pattern--0a3ead4e-6d47-4ccb-854c-a6a4f9d96b22'}) SET n:attack__ATTACKObject, n += {name: 'OS Credential Dumping', description: 'Adversaries may attempt to dump credentials to obtain account login and credential material, normally in the form of a hash or a clear text password.', url: 'https://attack.mitre.org/techniques/T1003', created: datetime('2017-05-31T21:30:19.735Z'), modified: datetime('2026-06-13T16:25:46.025Z'), domains: ['enterprise-attack'], version: '2.2', attackId: 'T1003', platforms: ['Linux', 'macOS', 'Windows'], isSubtechnique: false};
MERGE (n:attack__Technique {stixId: 'attack-pattern--f303a39a-6255-4b89-aecc-18c4d8ca7163'}) SET n:attack__ATTACKObject, n += {name: 'DCSync', description: 'Adversaries may attempt to access credentials and other sensitive information by abusing a Windows Domain Controller\'s application programming interface (API) to simulate the replication process from a remote domain controller using a technique called DCSync.', url: 'https://attack.mitre.org/techniques/T1003/006', created: datetime('2020-02-11T18:45:34.293Z'), modified: datetime('2026-11-04T00:13:20.464Z'), domains: ['enterprise-attack'], version: '1.1', attackId: 'T1003.006', platforms: ['Windows'], isSubtechnique: true};
