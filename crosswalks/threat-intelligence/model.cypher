MERGE (n:attack__Tactic {stixId: 'x-mitre-tactic--f72804c5-f15a-449e-a5da-2eecd181f813'}) SET n:attack__ATTACKObject, n += {name: 'Command and Control', description: 'The adversary is trying to communicate with compromised systems to control them.', url: 'https://attack.mitre.org/tactics/TA0011', created: datetime('2018-10-17T00:14:20.652Z'), modified: datetime('2025-04-25T14:45:36.561Z'), domains: ['enterprise-attack'], version: '1.0', attackId: 'TA0011', shortname: 'command-and-control'};
