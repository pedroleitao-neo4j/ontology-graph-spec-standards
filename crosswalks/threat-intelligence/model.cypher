MERGE (n:d3fend__OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1566.002'}) SET n:d3fend__D3FENDClass, n += {name: 'Spearphishing Link', definition: 'Adversaries may send spearphishing emails with a malicious link in an attempt to gain access to victim systems.', attackId: 'T1566.002', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204'}) SET n:d3fend__D3FENDClass, n += {name: 'User Execution', definition: 'An adversary may rely upon specific actions by a user in order to gain execution.', attackId: 'T1204', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204.001'}) SET n:d3fend__D3FENDClass, n += {name: 'Malicious Link', definition: 'An adversary may rely upon a user clicking a malicious link in order to gain execution.', attackId: 'T1204.001', framework: 'ATT&CK Enterprise'};
MERGE (n:d3fend__OffensiveTechnique {uri: 'http://d3fend.mitre.org/ontologies/d3fend.owl#T1204.002'}) SET n:d3fend__D3FENDClass, n += {name: 'Malicious File', definition: 'An adversary may rely upon a user opening a malicious file in order to gain execution.', attackId: 'T1204.002', framework: 'ATT&CK Enterprise'};
