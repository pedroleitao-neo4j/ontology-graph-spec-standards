// The sample data of every standard, then the crosswalk's own and its links

MERGE (n:eli__ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/REG'}) SET n:eli__Concept, n += {prefLabel: ['Regulation']};
MERGE (n:eli__ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/DIR'}) SET n:eli__Concept, n += {prefLabel: ['Directive']};
MERGE (n:eli__ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/CORRIGENDUM'}) SET n:eli__Concept, n += {prefLabel: ['Corrigendum']};
MERGE (n:eli__ResourceType {uri: 'http://publications.europa.eu/resource/authority/resource-type/DEC_FRAMW'}) SET n:eli__Concept, n += {prefLabel: ['Framework decision']};
MERGE (n:eli__Language {uri: 'http://publications.europa.eu/resource/authority/language/ENG'}) SET n:eli__Concept, n += {prefLabel: ['English']};
